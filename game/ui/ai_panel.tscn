[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/ai_panel.gd" id="1_ai_panel"]

[node name="AIPanel" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -280.0
offset_top = -220.0
offset_right = 280.0
offset_bottom = 220.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ai_panel")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "AI Entry"

[node name="PresetLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Preset"

[node name="PresetOption" type="OptionButton" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="BaseUrlLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Endpoint URL"

[node name="BaseUrlEdit" type="LineEdit" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="ModelLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Model"

[node name="ModelEdit" type="LineEdit" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="ApiKeyLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "API key (cloud only)"

[node name="ApiKeyEdit" type="LineEdit" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "sk-..."
secret = true

[node name="TopicLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Pack theme"

[node name="TopicEdit" type="LineEdit" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="GenerateButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Generate Pack"

[node name="StatusLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[connection signal="item_selected" from="Margin/VBox/PresetOption" to="." method="_on_preset_option_item_selected"]
[connection signal="pressed" from="Margin/VBox/GenerateButton" to="." method="_on_generate_button_pressed"]
